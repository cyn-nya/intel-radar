# ============================================================
#  最重要的一条：密钥绝不能提交
# ============================================================
# .env 里放的是你自己的 GitHub Token 和模型 API Key。
# 一旦推到公开仓库，GitHub 的密钥扫描会在几秒内发现并把它们吊销，
# 而且 git 历史里会永久留下记录（删文件也没用，得改写历史）。
.env
.env.local
.env.*.local
# .env.example 是模板，必须提交（上面几条都不会匹配到它）
!.env.example

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
#  运行时数据（每个人本地生成，不进仓库）
# ============================================================
# radar.db 是采集出来的仓库池/快照/榜单，radar.log 是运行日志，
# 都是本机产物。新克隆的人第一次跑会自动建。
data/

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
